# Copia este archivo a .env y complétalo con las credenciales reales del proyecto Supabase de
# Mente en Foco (las mismas que usa la web en su .env — busca VITE_SUPABASE_URL y
# VITE_SUPABASE_ANON_KEY en la raíz del repo). Expo requiere el prefijo EXPO_PUBLIC_ para que una
# variable esté disponible en el código del cliente.

EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
